{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parmar-backend-cloudflare",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "document-portal-d2b6d",
    "NODE_ENV": "production"
  },
  "kv_namespaces": [
    {
      "binding": "GOOGLE_OAUTH_STATE",
      "id": "92a5a99d6b0f4a5b990a96ca6ed89fb3"
    }
  ]
}
